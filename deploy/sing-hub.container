[Unit]
Description=Sing-Hub Management Core (Rootless)
After=network-online.target sing-box.service
Wants=network-online.target
StartLimitIntervalSec=5m
StartLimitBurst=5

[Container]
Image=ghcr.io/yuzjing/sing-hub:latest
ContainerName=sing-hub
AutoUpdate=registry

Network=infra.network

Environment=DATA_DIR=/data

Volume=/mnt/fast-data/databases/sing-hub:/data:U

Environment=TZ=Asia/Shanghai

[Service]
MemoryMax=256M
CPUWeight=100
Restart=on-failure

[Install]
WantedBy=default.target